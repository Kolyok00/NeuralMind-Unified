#!/bin/bash
# NeuralMind Bash Aliases and Functions

# Set NeuralMind environment
export NEURALMIND_PATH="/workspace/d_drive/projects/NeuralMind-Unified"
export PYTHONPATH="$NEURALMIND_PATH"
export NEURALMIND_ENV="development"

# NeuralMind aliases
alias neuralmind='cd "$NEURALMIND_PATH" && python3 main.py'
alias mcp='cd "$NEURALMIND_PATH" && python3 -m neuralmind.mcp_server'
alias neural-cd='cd "$NEURALMIND_PATH"'
alias neural-status='cd "$NEURALMIND_PATH" && python3 main.py --help'
alias neural-test='cd "$NEURALMIND_PATH" && python3 -c "import neuralmind; print(\"NeuralMind module loaded successfully\")"'

# Useful Linux aliases
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

# Git aliases
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git log --oneline'

# Python aliases
alias py='python3'
alias pip='pip3'
alias venv='python3 -m venv'

# Docker aliases (if needed)
alias dps='docker ps'
alias dimg='docker images'
alias dlog='docker logs'

# Docker Management Functions
docker_start() {
    echo "🐳 Starting Docker daemon..."
    /workspace/docker_setup.sh
}

docker_status() {
    if sudo docker info > /dev/null 2>&1; then
        echo "✅ Docker is running"
        sudo docker version --format "{{.Server.Version}}"
    else
        echo "❌ Docker is not running"
        echo "💡 Run 'docker_start' to start Docker"
    fi
}

# MCP (Model Context Protocol) Functions
mcp_start() {
    echo "🧠 Starting NeuralMind MCP Server..."
    cd /workspace/d_drive/projects/NeuralMind-Unified
    python3 -m neuralmind.mcp_server &
    echo "✅ MCP Server started on port 3001"
    echo "🔗 Connect in Cursor: mcp://localhost:3001"
}

mcp_test() {
    echo "🧪 Testing MCP connection..."
    if curl -s http://localhost:3001/health > /dev/null 2>&1; then
        echo "✅ MCP Server is responding"
    else
        echo "❌ MCP Server not responding"
        echo "💡 Run 'mcp_start' to start the server"
    fi
}

